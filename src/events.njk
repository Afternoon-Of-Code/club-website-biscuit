---
layout: base.njk
title: Events - South Asian Student Society
description: Discover upcoming and past events from the South Asian Student Society
---

<!-- Upcoming Events -->
<section class="pt-32 pb-16 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto" id="upcoming-events">
  <h2 class="text-4xl md:text-5xl font-bold text-center text-primary mb-8">
    Upcoming Events
  </h2>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 py-8" x-show="events.length > 0">
    <template x-for="(event, index) in events" :key="index">
      <div class="timeline-item-animate glass-effect border-primary rounded-xl p-6 overflow-hidden event-card-hover">
        <div
          class="w-full h-48 rounded-lg mb-4 bg-secondary bg-cover bg-center"
          :style="event ? `background-image: url('${getEventPoster(event)}');` : ''">
        </div>
        <div>
          <p class="text-primary font-bold mb-2" x-text="formatDate(event.start.dateTime || event.start.date)"></p>
          <h3 class="text-xl font-semibold text-text mb-2" x-text="event.summary"></h3>
          <p class="text-text opacity-100 text-sm mb-3" x-text="event.description || 'Lorem ipsum dolor sit amet, consectetur adipiscing elit.'"></p>
          <p class="text-primary text-sm" x-show="event.location">
            <strong>Location:</strong> <span x-text="event.location"></span>
          </p>
        </div>
      </div>
    </template>
  </div>

  <div x-show="events.length === 0 && !loading" class="text-center py-12">
    <p class="text-xl text-text opacity-100">No upcoming events at the moment. Check back soon!</p>
  </div>

  <div x-show="loading" class="text-center py-12">
    <p class="text-xl text-text opacity-100">Loading events...</p>
  </div>

  <div class="text-center mt-8">
    <a href="https://calendar.google.com" target="_blank" class="btn-hover inline-block bg-primary text-light px-8 py-3 rounded-lg font-bold shadow-lg">
      View Full Calendar
    </a>
  </div>
</section>

