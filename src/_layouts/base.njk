    <svg x-show="!isDark" class="sun-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path>
    </svg>
    <svg x-show="isDark" class="moon-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path>
    </svg>
  </div> -->

  <!-- Footer -->
  <footer class="section-overlay mt-16 py-12 text-center animate-fade-in">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex justify-center gap-8 mb-6 flex-wrap">
        <a href="/" class="footer-link-hover text-text">Home</a>
        <a href="/events/" class="footer-link-hover text-text">Events</a>
        <a href="/about/" class="footer-link-hover text-text">About</a>
        <a href="/join/" class="footer-link-hover text-text">Join Us</a>
        <a href="mailto:contact@sass.edu" class="footer-link-hover text-text">Contact</a>
      </nav>

      <div class="text-text text-sm mt-4">
        <p>&copy; {% year %} South Asian Student Society. All rights reserved.</p>
        <p class="mt-2">Made with ❤️ by Anshu Pathak</p>
      </div>
    </div>
  </footer>

</body>
</html>
