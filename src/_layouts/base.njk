<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title or "South Asian Student Society" }}</title>
  <meta name="description" content="{{ description or 'Represent South Asian cultures & embrace the student community' }}">

  <!-- Styles -->
  <link rel="stylesheet" href="/css/style.css">

  <!-- Alpine.js -->
  <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>

  <!-- Custom JavaScript -->
  <script src="/js/main.js"></script>
</head>
<body x-data="app" class="antialiased">

  <!-- Navigation Bar -->
  <nav class="navbar-sticky shadow-lg animate-slide-down">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
      <div class="flex justify-between items-center">
        <a href="/" class="text-2xl font-bold text-text hover:text-primary transition-colors duration-300">
          SASS
        </a>
        <ul class="flex gap-8">
          <li><a href="/" class="nav-link-hover text-text font-medium">Home</a></li>
          <li><a href="/events/" class="nav-link-hover text-text font-medium">Events</a></li>
          <li><a href="/about/" class="nav-link-hover text-text font-medium">About</a></li>
          <li><a href="/join/" class="nav-link-hover text-text font-medium">Join Us</a></li>
        </ul>
      </div>
    </div>
  </nav>

  <!-- Main Content -->
  <main>
    {{ content | safe }}
  </main>

  <!-- Theme Toggle Button - Disabled for now, keep for future use -->
